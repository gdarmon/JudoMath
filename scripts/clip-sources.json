{
  "$comment": "Channels & playlists feeding scripts/fetch-judo-clips.mjs. The script pulls each channel's RSS/recent videos, filters by kid-safe judo keywords, then validates every survivor via YouTube oEmbed. includeAll is reserved for kid-focused judo channels.",

  "targetCount": 100,
  "minDurationSeconds": 30,
  "maxDurationSeconds": 900,

  "$comment2": "titleMustContain is OR — any one of these in the title keeps the clip. titleMustAlsoContain is AND — every clip MUST also contain at least one of these (we always require something judo-related to keep wide-channel videos out).",
  "titleMustContain": [
    "judo",
    "ippon",
    "seoi",
    "uchi mata",
    "uchimata",
    "harai goshi",
    "haraigoshi",
    "osoto",
