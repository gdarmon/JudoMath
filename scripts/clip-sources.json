    "tachi waza",
    "tachi-waza",
    "kano",
    "kodokan",
    "judogi",
    "judoka",
    "judokids",
    "judotraining",
    "judothrow",
    "ג'ודו",
    "גודו",
    "ג׳ודו",
    "sasae",
    "harai",
    "guruma",
    "gake",
    "makikomi",
    "osaekomi",
    "throw",
    "throws",
    "sweep",
    "sweeps",
    "breakfall",
    "fallschule",
    "judo macht fit",
    "gigi judo"
  ],

  "titleMustNotContain": [
